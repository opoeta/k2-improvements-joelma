; HEADER_BLOCK_START
; generated by Creality_Print V7.0.1.4212 on [year]-[month]-[day] at [hour]:[minute]:[second]
; total layer number: [total_layer_count]
; HEADER_BLOCK_END
; SET PRINT AREA MIN AND MAX COORDINATES TO ENABLE ADAPTIVE PROBING
; MINX = {first_layer_print_min[0]}
; MINY = {first_layer_print_min[1]}
; MAXX = {first_layer_print_max[0]}
; MAXY = {first_layer_print_max[1]}
; ===== OrcaSlicer - K2 Plus + CFS + k2-improvements =====
; Porte fiel do G-code inicial do Creality Print. O cabecalho declara
; Creality_Print V7.0.1.4212 de proposito: o firmware da K2 recusa arquivos sem
; ele (atualize a versao se o Creality Print mudar). Diferencas: o Orca nao tem
; multicolor_method -> o ritual de carga do CFS roda sempre (imprimindo pelo CFS);
; purga inicial com 1 bloco de 90 mm (o original fazia 3x90).
; Requisitos: Processo -> Outros -> "Etiquetar objetos" LIGADO;
;             Impressora -> Geral -> "Usar distancias E relativas" LIGADO.
; PLACAS NOMEADAS: adicione PLATE=<nome> no fim da linha do START_PRINT.
START_PRINT EXTRUDER_TEMP=[nozzle_temperature_initial_layer] BED_TEMP=[bed_temperature_initial_layer_single] CHAMBER_TEMP=[chamber_temperature] MATERIAL={filament_type[initial_extruder]} CURR_BED_TYPE="{curr_bed_type}" ADAPTIVE=1

M83
M8200 P S[initial_no_support_extruder]
M220 S100
G0 Y200 F12000
G0 X10
SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=25000
G0 F30000

M8200 C S0
SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=5000
G0 Y345 F18000
G0 X139
G0 Y378
G0 X133
M8200 R
M104 S[nozzle_temperature_range_high[initial_no_support_extruder]]
M8200 L I[initial_no_support_extruder]
M106 S0
M106 P2 S0
T[initial_no_support_extruder]

; FLUSH_START
M106 S30
G1 F60
M400
M104 S[nozzle_temperature_initial_layer]
G1 E{90 * 0.18} F{filament_max_volumetric_speed[initial_no_support_extruder]/2.4053*60}
G1 E{90 * 0.02} F60
G1 E{90 * 0.18} F{filament_max_volumetric_speed[initial_no_support_extruder]/2.4053*60}
G1 E{90 * 0.02} F60
G1 E{90 * 0.18} F{filament_max_volumetric_speed[initial_no_support_extruder]/2.4053*60}
G1 E{90 * 0.02} F60
G1 E{90 * 0.18} F{filament_max_volumetric_speed[initial_no_support_extruder]/2.4053*60}
G1 E{90 * 0.02} F60
G1 E{90 * 0.18} F{filament_max_volumetric_speed[initial_no_support_extruder]/2.4053*60}
G1 E{90 * 0.02} F60

M400
M106 S255
G4 P5000
M106 S0
G1 E-[retract_length_toolchange[initial_no_support_extruder]] F1800
; FLUSH_END

; WIPE
SET_VELOCITY_LIMIT ACCEL=5000 ACCEL_TO_DECEL=5000
G0 X160 F12000
G0 X135

G0 X160 Y374 F12000
G2 I4 J0 P1 F10000
G0 X170 Y374 F12000
G3 I-4 J0 P1 F10000

G0 X160 Y378 F12000
G0 X133 Y378 F12000
G0 X160 Y378 F12000
G0 X133 Y378 F12000
G0 X160 Y378 F12000
G0 X133 Y378 F12000

M8200 O
M204 S2000
M83
M109 S[nozzle_temperature_initial_layer]
LINE_PURGE
